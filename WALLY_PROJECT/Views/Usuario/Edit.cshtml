@model WALLY_PROJECT.Models.Usuario

@{
    Layout = null;
    ViewBag.Title = "Editar Usuario";
    string rol = Session["Rol"] != null ? Session["Rol"].ToString().ToUpper() : "";
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>@ViewBag.Title</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <style>
        body {
            font-family: 'Segoe UI', sans-serif;
            background-color: #c8f8e4;
        }

        .container {
            background-color: white;
            margin-top: 50px;
            padding: 30px;
            border-radius: 15px;
            box-shadow: 0 4px 10px rgba(0,0,0,0.1);
            max-width: 800px;
        }

        h2 {
            color: #009966;
            text-align: center;
            margin-bottom: 30px;
        }

        .btn-primary {
            background-color: #009966;
            border-color: #009966;
        }

            .btn-primary:hover {
                background-color: #007f5f;
            }

        .form-control:focus {
            border-color: #00b377;
            box-shadow: 0 0 0 0.2rem rgba(0,179,119,0.25);
        }
    </style>
</head>
<body>

    <div class="container">
        <h2>Editar Usuario</h2>

        @if (ViewBag.Success != null)
        {
            <div class="alert alert-success">@ViewBag.Success</div>
        }

        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger">@ViewBag.Error</div>
        }

        @using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()

            @Html.HiddenFor(model => model.ID_USUARIO)

            <div class="mb-3">
                @Html.LabelFor(model => model.U_TXT_USUARIO, new { @class = "form-label" })
                @Html.EditorFor(model => model.U_TXT_USUARIO, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.U_TXT_USUARIO, "", new { @class = "text-danger" })
            </div>

            <div class="mb-3">
                @Html.LabelFor(model => model.U_EMAIL, new { @class = "form-label" })
                @Html.EditorFor(model => model.U_EMAIL, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.U_EMAIL, "", new { @class = "text-danger" })
            </div>

            <div class="d-flex justify-content-between">
                <input type="submit" value="Guardar Cambios" class="btn btn-primary" />

                @if (rol == "ADMIN")
                {
                    <a href="@Url.Action("Index", "Usuario")" class="btn btn-secondary">Volver</a>
                }
                else
                {
                    <a href="@Url.Action("Index", "Home")" class="btn btn-secondary">Volver</a>
                }
            </div>
        }
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
