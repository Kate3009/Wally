@model WALLY_PROJECT.Models.Usuario

@{
    Layout = null;
    ViewBag.Title = "Editar Usuario";
    var userId = Session["UsuarioId"] != null ? Session["UsuarioId"].ToString() : "0";
    var perfil = Session["Perfil"] != null ? Session["Perfil"].ToString() : "Cliente";
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>@ViewBag.Title</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

    <style>
        body {
            margin: 0;
            font-family: 'Segoe UI', sans-serif;
            background-color: #00cc66; /* fondo verde fuerte */
        }

        nav {
            background-color: #009966;
            padding: 15px 30px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            color: white;
        }

            nav .logo {
                font-weight: bold;
                font-size: 1.5rem;
            }

            nav .nav-links a {
                color: white;
                text-decoration: none;
                margin-left: 20px;
                font-weight: bold;
                transition: color 0.3s;
            }

                nav .nav-links a:hover {
                    color: #c8f8e4;
                }

        .container {
            background-color: white;
            margin-top: 50px;
            padding: 30px;
            border-radius: 15px;
            box-shadow: 0 4px 10px rgba(0,0,0,0.1);
            max-width: 800px;
        }

        h2 {
            color: #009966;
            text-align: center;
            margin-bottom: 30px;
        }

        .btn-primary {
            background-color: #009966;
            border-color: #009966;
        }

            .btn-primary:hover {
                background-color: #007f5f;
            }

        .form-control:focus {
            border-color: #00b377;
            box-shadow: 0 0 0 0.2rem rgba(0,179,119,0.25);
        }
    </style>
</head>
<body>
    <!-- NAVBAR -->
    <nav>
        <div class="logo">WALLY</div>
        <div class="nav-links">
            
            <a href="/Login/IniciarSesion">Cerrar Sesión</a>
        </div>
    </nav>

    <div class="container">
        <h2>Editar Usuario</h2>

        @if (ViewBag.Success != null)
        {
            <div class="alert alert-success">@ViewBag.Success</div>
        }

        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger">@ViewBag.Error</div>
        }

        @using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()

            @Html.HiddenFor(model => model.ID_USUARIO)

            <div class="mb-3">
                @Html.LabelFor(model => model.U_TXT_USUARIO, new { @class = "form-label" })
                @Html.EditorFor(model => model.U_TXT_USUARIO, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.U_TXT_USUARIO, "", new { @class = "text-danger" })
            </div>

            <div class="mb-3">
                @Html.LabelFor(model => model.U_EMAIL, new { @class = "form-label" })
                @Html.EditorFor(model => model.U_EMAIL, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.U_EMAIL, "", new { @class = "text-danger" })
            </div>

            <div class="d-flex justify-content-between">
                <input type="submit" value="Guardar Cambios" class="btn btn-primary" />

                @if (perfil == "ADMIN")
                {
                    <a href="@Url.Action("Index", "Usuario")" class="btn btn-secondary">Volver</a>
                }
                else
                {
                    <a href="@Url.Action("Index", "Home")" class="btn btn-secondary">Volver</a>
                }
            </div>
        }
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
