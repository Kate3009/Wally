@model WALLY_PROJECT.Models.Usuario

@{
    Layout = null;
    ViewBag.Title = "Crear Usuario";
    string rol = Session["Rol"] != null ? Session["Rol"].ToString().ToUpper() : "";
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>@ViewBag.Title</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <style>
        body {
            font-family: 'Segoe UI', sans-serif;
            background-color: #c8f8e4;
        }

        .container {
            background-color: white;
            margin-top: 50px;
            padding: 30px;
            border-radius: 15px;
            box-shadow: 0 4px 10px rgba(0,0,0,0.1);
            max-width: 800px;
        }

        h2 {
            color: #009966;
            text-align: center;
            margin-bottom: 30px;
        }

        .btn-primary {
            background-color: #009966;
            border-color: #009966;
        }

            .btn-primary:hover {
                background-color: #007f5f;
            }

        .form-control:focus {
            border-color: #00b377;
            box-shadow: 0 0 0 0.2rem rgba(0,179,119,0.25);
        }
    </style>
</head>
<body>

    <div class="container">
        <h2>Crear Usuario</h2>

        @if (ViewBag.Success != null)
        {
            <div class="alert alert-success">@ViewBag.Success</div>
        }

        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger">@ViewBag.Error</div>
        }

        @using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()
            @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })

            <div class="mb-3">
                @Html.LabelFor(model => model.U_TXT_USUARIO)
                @Html.TextBoxFor(model => model.U_TXT_USUARIO, new { @class = "form-control" })
            </div>

            <div class="mb-3">
                @Html.LabelFor(model => model.U_TXT_ACCESO)
                @Html.PasswordFor(model => model.U_TXT_ACCESO, new { @class = "form-control" })
            </div>

            <div class="mb-3">
                @Html.LabelFor(model => model.U_NOMBRES)
                @Html.TextBoxFor(model => model.U_NOMBRES, new { @class = "form-control" })
            </div>

            <div class="mb-3">
                @Html.LabelFor(model => model.U_APE_PATERNO)
                @Html.TextBoxFor(model => model.U_APE_PATERNO, new { @class = "form-control" })
            </div>

            <div class="mb-3">
                @Html.LabelFor(model => model.U_APE_MATERNO)
                @Html.TextBoxFor(model => model.U_APE_MATERNO, new { @class = "form-control" })
            </div>

            <div class="mb-3">
                @Html.LabelFor(model => model.U_EMAIL)
                @Html.TextBoxFor(model => model.U_EMAIL, new { @class = "form-control" })
            </div>

            <div class="mb-3">
                @Html.LabelFor(model => model.U_NUM_IDENTIDAD)
                @Html.TextBoxFor(model => model.U_NUM_IDENTIDAD, new { @class = "form-control" })
            </div>

            <div class="d-flex justify-content-between">
                <input type="submit" value="Crear" class="btn btn-primary" />
                @if (rol == "ADMIN")
                {
                    <a href="@Url.Action("Index", "Usuario")" class="btn btn-secondary">Volver</a>
                }
                else
                {
                    <a href="@Url.Action("IniciarSesion", "Login")" class="btn btn-secondary">Volver</a>
                }
            </div>
        }
    </div>

