@model WALLY_PROJECT.Models.Usuario

@{
    Layout = null;
    ViewBag.Title = "Crear Usuario";
    string rol = Session["Rol"] != null ? Session["Rol"].ToString().ToUpper() : "";
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>@ViewBag.Title</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <style>
        body {
            font-family: 'Segoe UI', sans-serif;
            background-color: #c8f8e4;
        }

        .container {
            background-color: #e0fce0;
            padding: 40px;
            border-radius: 20px;
            margin-top: 50px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
            max-width: 850px;
        }

        h2 {
            color: #006400;
        }

        .form-label {
            font-weight: bold;
            color: #006400;
        }

        .btn-success {
            background-color: #009966;
            border-color: #009966;
        }

            .btn-success:hover {
                background-color: #007f5f;
            }

        .btn-default {
            background-color: #cccccc;
            color: #333;
        }

        .alert {
            margin-bottom: 20px;
        }
    </style>
</head>
<body>
    <div class="container">
        <h2 class="text-center">Crear nuevo usuario</h2>

        @* Mensajes de éxito o error *@
        @if (ViewBag.Success != null)
        {
            <div class="alert alert-success text-center">@ViewBag.Success</div>
        }

        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger text-center">@ViewBag.Error</div>
        }

        @using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()
            @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })

            <div class="mb-3">
                @Html.LabelFor(m => m.U_TXT_USUARIO, htmlAttributes: new { @class = "form-label" })
                @Html.TextBoxFor(m => m.U_TXT_USUARIO, new { @class = "form-control", placeholder = "Nombre de usuario" })
            </div>

            <div class="mb-3">
                @Html.LabelFor(m => m.U_TXT_ACCESO, htmlAttributes: new { @class = "form-label" })
                @Html.PasswordFor(m => m.U_TXT_ACCESO, new { @class = "form-control", placeholder = "Contraseña" })
            </div>

            <div class="mb-3">
                <label class="form-label">Confirmar Contraseña</label>
                <input type="password" name="ConfirmPassword" class="form-control" placeholder="Confirmar contraseña" required />
                @if (ViewBag.PasswordMismatch != null)
                {
                    <span class="text-danger">@ViewBag.PasswordMismatch</span>
                }
            </div>

            <div class="mb-3">
                @Html.LabelFor(m => m.U_NOMBRES, htmlAttributes: new { @class = "form-label" })
                @Html.TextBoxFor(m => m.U_NOMBRES, new { @class = "form-control", placeholder = "Nombres" })
            </div>

            <div class="mb-3">
                @Html.LabelFor(m => m.U_APE_PATERNO, htmlAttributes: new { @class = "form-label" })
                @Html.TextBoxFor(m => m.U_APE_PATERNO, new { @class = "form-control", placeholder = "Apellido paterno" })
            </div>

            <div class="mb-3">
                @Html.LabelFor(m => m.U_APE_MATERNO, htmlAttributes: new { @class = "form-label" })
                @Html.TextBoxFor(m => m.U_APE_MATERNO, new { @class = "form-control", placeholder = "Apellido materno" })
            </div>

            <div class="mb-3">
                @Html.LabelFor(m => m.U_EMAIL, htmlAttributes: new { @class = "form-label" })
                @Html.TextBoxFor(m => m.U_EMAIL, new { @class = "form-control", placeholder = "Correo electrónico" })
            </div>

            <div class="mb-3">
                @Html.LabelFor(m => m.U_NUM_IDENTIDAD, htmlAttributes: new { @class = "form-label" })
                @Html.TextBoxFor(m => m.U_NUM_IDENTIDAD, new { @class = "form-control", placeholder = "DNI / Identidad" })
            </div>

            <div class="d-flex justify-content-between">
                <input type="submit" value="Crear" class="btn btn-success px-4" />

                @if (rol == "ADMIN")
                {
                    <a href="@Url.Action("Index", "Usuario")" class="btn btn-default px-4">Volver</a>
                }
                else
                {
                    <a href="@Url.Action("IniciarSesion", "Login")" class="btn btn-default px-4">Volver</a>
                }
            </div>
        }
    </div>
</body>
</html>
