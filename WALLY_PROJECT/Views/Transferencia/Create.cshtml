@model WALLY_PROJECT.Models.Transaccion

@{
    ViewBag.Title = "Transferencia";
    var userId = Session["UsuarioId"] != null ? Session["UsuarioId"].ToString() : "0";
    var perfil = Session["Perfil"] != null ? Session["Perfil"].ToString() : "Cliente";
}

<style>
    body {
        margin: 0;
        width: 100%;
        font-family: 'Segoe UI', sans-serif;
        background-color: #00cc66;
    }

    nav {
        width: 100%;
        background-color: #009966;
        padding: 15px 30px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        color: white;
        margin: 0;
    }

        nav .logo {
            font-weight: bold;
            font-size: 1.5rem;
        }

        nav .nav-links a {
            color: white;
            text-decoration: none;
            margin-left: 20px;
            font-weight: bold;
            transition: color 0.3s;
        }

            nav .nav-links a:hover {
                color: #c8f8e4;
            }

    .form-container {
        background-color: #e0fce0;
        padding: 40px;
        border-radius: 20px;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
        max-width: 850px;
        width: 90%;
        margin: auto;
    }

    .form-group {
        margin-bottom: 20px;
    }
</style>

<!-- NAVBAR -->
<nav>
    <div class="logo">WALLY</div>
    <div class="nav-links">
        <a href="/Login/IniciarSesion">Cerrar Sesión</a>
    </div>
</nav>

<h2 class="text-dark text-center my-4">Transferencia de Fondos</h2>

<div class="form-container">
    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()

        <!-- Mensajes -->
        if (ViewBag.Success != null)
        {
            <div class="alert alert-success">@ViewBag.Success</div>
        }
        if (ViewBag.Error != null)
        {
            <div class="alert alert-danger">@ViewBag.Error</div>
        }

        <!-- Cuenta Origen Oculta -->
        @Html.HiddenFor(m => m.T_CUENTA_ORIGEN)

        <!-- Buscador de cuenta destino -->
        <div class="form-group">
            <label>Buscar Usuario Destino</label>
            <input type="text" id="busquedaUsuario" class="form-control" placeholder="Buscar por nombre o email" autocomplete="off" />
            <ul id="sugerencias" class="list-group"></ul>
        </div>

        <div class="form-group">
            <label>Usuario Seleccionado</label>
            <input type="text" id="nombreCompleto" class="form-control" disabled />
            @Html.HiddenFor(m => m.T_CUENTA_DESTINO, new { id = "T_CUENTA_DESTINO" })
            @Html.ValidationMessageFor(m => m.T_CUENTA_DESTINO, "", new { @class = "text-danger" })
        </div>

        <!-- Monto -->
        <div class="form-group">
            @Html.LabelFor(m => m.T_MONTO)
            @Html.EditorFor(m => m.T_MONTO, new { htmlAttributes = new { @class = "form-control", type = "number", min = "0", step = "0.01" } })
            @Html.ValidationMessageFor(m => m.T_MONTO, "", new { @class = "text-danger" })
        </div>

        <!-- Detalle -->
        <div class="form-group">
            @Html.LabelFor(m => m.T_DETALLE)
            @Html.TextAreaFor(m => m.T_DETALLE, new { @class = "form-control", rows = 3 })
            @Html.ValidationMessageFor(m => m.T_DETALLE, "", new { @class = "text-danger" })
        </div>

        <!-- Botones -->
        <div class="form-group text-center">
            <input type="submit" value="Transferir" class="btn btn-success" />
            <a class="btn btn-dark" style="margin-left:20px" href="@Url.Action("Index", "Home")">Volver</a>
        </div>
    }
</div>
<!-- Modal de Transferencia Exitosa -->
<div class="modal fade" id="modalExito" tabindex="-1" role="dialog" aria-labelledby="modalExitoLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title" id="modalExitoLabel">Transferencia Exitosa</h5>
                <button type="button" class="close text-white" data-dismiss="modal" aria-label="Cerrar">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                La transferencia se ha realizado correctamente.
            </div>
            <div class="modal-footer">
                <a href="@Url.Action("DescargarComprobante", "Transferencia")" class="btn btn-primary">Exportar comprobante</a>
                <a href="@Url.Action("Index", "Home")" class="btn btn-secondary">Volver al menú</a>
            </div>
        </div>
    </div>
</div>


@section Scripts {
    <script>
        document.getElementById("busquedaUsuario").addEventListener("input", async function () {
            const query = this.value;
            if (query.length < 2) return;

            try {
                const response = await fetch('/Usuario/Buscar?q=' + query);
                if (!response.ok) throw new Error("Error en la búsqueda");

                const data = await response.json();
                const sugerencias = document.getElementById("sugerencias");
                sugerencias.innerHTML = "";

                data.forEach(usuario => {
                    const li = document.createElement("li");
                    li.classList.add("list-group-item");
                    li.textContent = usuario.nombre_completo + ' (' + usuario.usuario + ')';
                    li.addEventListener("click", function () {
                        document.getElementById("nombreCompleto").value = usuario.nombre_completo;
                        document.getElementById("T_CUENTA_DESTINO").value = usuario.id;
                        sugerencias.innerHTML = "";
                    });
                    sugerencias.appendChild(li);
                });
            } catch (error) {
                console.error("Error al buscar usuarios:", error);
            }
        });
    </script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.0/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        $(document).ready(function () {
            var success = '@ViewBag.Success';
            if (success) {
                $('#modalExito').modal('show');
            }
        });
    </script>
}
